# Minimalistic makefile to compile stuff
# Works for two nodes communicating with each other

RISCV_PFX=riscv64-unknown-elf-
RISCV_CC=$(RISCV_PFX)gcc

BINARY_OPT=-O3 -static -specs=htif_nano.specs


CLIENT=client
CLIENT_RISCV=$(CLIENT).riscv
SERVER=server
SERVER_RISCV=$(SERVER).riscv

all: $(CLIENT_RISCV) $(SERVER_RISCV)

INCLUDE_DIR=../common

NPACKETS=100
PACKET_WORDS=180

# want client on node 0 and server on node 1
# these are firesim defaults
CLIENT_MAC=0x0200006D1200
SERVER_MAC=0x0300006D1200

# tricky. both bins start at different times. need server to start 1st then the client should run then the server should end
SERVER_WAIT=1000000000UL
CLIENT_START_WAIT=100000UL
CLIENT_END_WAIT=400UL
CLIENT_WAIT=300000UL

SERVER_MACROS=-DCLIENT_MACADDR=$(CLIENT_MAC) -DSERVER_MACADDR=$(SERVER_MAC) -DNPACKETS=$(NPACKETS) -DPACKET_WORDS=$(PACKET_WORDS) -DWAIT_CYCLE=$(SERVER_WAIT)
CLIENT_MACROS=-DCLIENT_MACADDR=$(CLIENT_MAC) -DSERVER_MACADDR=$(SERVER_MAC) -DNPACKETS=$(NPACKETS) -DPACKET_WORDS=$(PACKET_WORDS) -DSTART_WAIT_CYCLE=$(CLIENT_START_WAIT) -DEND_WAIT_CYCLE=$(CLIENT_END_WAIT) -DWAIT_CYCLE=$(CLIENT_WAIT)

all: $(CLIENT_RISCV) $(SERVER_RISCV)

$(CLIENT_RISCV): $(CLIENT).c
	$(RISCV_CC) $(BINARY_OPT) -I$(INCLUDE_DIR) -o $@ $^ $(CLIENT_MACROS)

$(SERVER_RISCV): $(SERVER).c
	$(RISCV_CC) $(BINARY_OPT) -I$(INCLUDE_DIR) -o $@ $^ $(SERVER_MACROS)


.PHONY: clean
clean:
	rm -f $(CLIENT_RISCV) $(SERVER_RISCV)
